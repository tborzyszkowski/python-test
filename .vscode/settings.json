    ,"src/03-test_double/04-sso-registry/examples"
    ,"src/03-test_double/04-sso-registry/exercises"
  ],
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "chat.tools.terminal.autoApprove": {
    "rtk": true
  }
