{
  // Testy uruchamiamy przez pytest - obsługuje on takze klasy unittest.TestCase.
  // Aby uzywac wlasnego runnera unittest, ustaw pytestEnabled na false
  // i unittestEnabled na true.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["src"],
  "python.testing.cwd": "${workspaceFolder}",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.extraPaths": [
    "src/01-OOP",
    "src/01-OOP/01-class-vs-object/examples",
    "src/01-OOP/01-class-vs-object/exercises",
    "src/01-OOP/02-encapsulation-property/examples",
    "src/01-OOP/02-encapsulation-property/exercises",
    "src/01-OOP/03-composition/examples",
    "src/01-OOP/03-composition/exercises",
    "src/01-OOP/04-inheritance-polymorphism/examples",
    "src/01-OOP/04-inheritance-polymorphism/exercises",
    "src/01-OOP/05-aaa-pattern/examples",
    "src/01-OOP/05-aaa-pattern/exercises",
    "src/01-OOP/06-unit-test-anatomy/examples",
    "src/01-OOP/06-unit-test-anatomy/exercises",
    "src/01-OOP/07-testing-frameworks/examples",
    "src/01-OOP/07-testing-frameworks/exercises",
    "src/02-TDD",
    "src/02-TDD/01-red-green-refactor/examples",
    "src/02-TDD/01-red-green-refactor/exercises",
    "src/02-TDD/02-test-pyramid-quadrants/examples",
    "src/02-TDD/02-test-pyramid-quadrants/exercises",
    "src/02-TDD/03-technical-debt/examples",
    "src/02-TDD/03-technical-debt/exercises",
    "src/02-TDD/04-first-and-test-scope/examples",
    "src/02-TDD/04-first-and-test-scope/exercises",
    "src/02-TDD/05-tdd-string-calculator/examples",
    "src/02-TDD/05-tdd-string-calculator/exercises",
    "src/02-TDD/06-tdd-shopping-cart/examples",
    "src/02-TDD/06-tdd-shopping-cart/exercises",
    "src/02-TDD/07-tdd-bank-account/examples",
    "src/02-TDD/07-tdd-bank-account/exercises",
    "src/02-TDD/08-tdd-review-and-practice/exercises"
